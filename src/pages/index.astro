---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, formatDate, readingTime } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const hasPage = (p: (typeof projects)[number]) => Boolean(p.body?.trim());
const awards = projects.filter((p) => p.data.award).length;
const typeLabel = { software: 'Software', hardware: 'Hardware', hackathon: 'Hackathon' };
const filters = [
  { key: 'all', label: 'All', count: projects.length },
  ...(['software', 'hardware', 'hackathon'] as const).map((t) => ({
    key: t,
    label: t === 'hackathon' ? 'Hackathons' : typeLabel[t],
    count: projects.filter((p) => p.data.type === t).length,
  })),
];
---

<Base section="work">
  <section class="hero narrow">
    <p class="eyebrow">{site.role}</p>
    <h1>{site.name}</h1>
    <p class="sub">{site.pitch}</p>
    <div class="ctas">
      <a class="btn" href="#projects">See projects</a>
      <a class="chev" href={site.github}>GitHub</a>
    </div>
  </section>

  <section class="band" id="projects">
    <div class="wrap">
      <div class="head">
        <h2>Projects</h2>
        <p class="num">{projects.length} projects{awards > 0 && `, ${awards} hackathon awards`}.</p>
        <div class="seg" role="group" aria-label="Filter projects">
          {filters.filter((f) => f.key === 'all' || f.count > 0).map((f) => (
            <button type="button" data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
      </div>

      <div class="tiles">
        {projects.map((p) => (
          <article class="tile" data-type={p.data.type}>
            {p.data.award && <p class="eyebrow award">{p.data.award}</p>}
            <h3>{p.data.title}</h3>
            <p class="meta">
              {typeLabel[p.data.type]} &middot; {formatDate(p.data.date)}{p.data.event && <> &middot; {p.data.event}</>}
            </p>
            <p class="summary">{p.data.summary}</p>
            {p.data.learned && <p class="learned"><span>What I learned.</span> {p.data.learned}</p>}
            <div class="links">
              {hasPage(p) && <a class="chev" href={`/projects/${p.id}/`}>Read more</a>}
              {Object.entries(p.data.links).map(([label, href]) => <a class="chev" href={href}>{label}</a>)}
            </div>
            {p.data.image && <Image class="shot" src={p.data.image} alt={p.data.imageAlt ?? ''} widths={[480, 960]} sizes="(max-width: 834px) 100vw, 480px" />}
          </article>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="writing narrow">
      <h2>Writing</h2>
      {posts.map((post) => (
        <a class="post" href={`/writing/${post.id}/`}>
          <span class="t">{post.data.title}</span>
          <span class="d num">{formatDate(post.data.date)} &middot; {readingTime(post.body)} min read</span>
        </a>
      ))}
      <a class="chev all" href="/writing/">All posts</a>
    </section>
  )}
</Base>

<script>
  const tiles = document.querySelectorAll<HTMLElement>('.tile');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      tiles.forEach((t) => (t.hidden = f !== 'all' && t.dataset.type !== f));
    });
  });
</script>

<style>
  .hero { text-align: center; padding-block: clamp(64px, 11vw, 120px) clamp(56px, 9vw, 100px); display: grid; gap: 10px; justify-items: center; }
  .hero h1 { margin: 0; font-family: var(--display); font-size: clamp(48px, 9vw, 80px); font-weight: 700; line-height: 1.05; letter-spacing: -0.015em; }
  .hero .sub { margin: 6px 0 0; font-family: var(--display); font-size: clamp(21px, 2.8vw, 28px); line-height: 1.25; letter-spacing: .004em; color: var(--dim); max-width: 30ch; text-wrap: balance; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px 28px; margin-top: 24px; font-size: 17px; }

  .band { padding-block: clamp(56px, 8vw, 96px); }
  .head { text-align: center; display: grid; gap: 8px; justify-items: center; margin-bottom: 36px; }
  .head h2 { margin: 0; font-family: var(--display); font-size: clamp(36px, 5.5vw, 56px); font-weight: 700; line-height: 1.07; letter-spacing: -0.005em; }
  .head p { margin: 0; color: var(--dim); font-size: 19px; }
  .seg { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 2px; background: var(--seg); padding: 3px; border-radius: 980px; margin-top: 16px; }
  .seg button { font: 500 14px var(--sans); letter-spacing: -0.01em; color: var(--ink); background: transparent; border: 0; padding: 7px 16px; border-radius: 980px; cursor: pointer; }
  .seg button[aria-pressed='true'] { background: var(--seg-on); box-shadow: 0 1px 3px rgba(0, 0, 0, .12); }

  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .tile { background: var(--tile); border-radius: 18px; padding: clamp(28px, 4vw, 44px) clamp(22px, 3.5vw, 40px); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 0; }
  .tile[hidden] { display: none; }
  .tile h3 { margin: 0; font-family: var(--display); font-size: clamp(28px, 3.4vw, 36px); font-weight: 700; line-height: 1.1; letter-spacing: -0.003em; text-wrap: balance; }
  .tile .meta { margin: 0; font-size: 14px; color: var(--dim); text-wrap: balance; }
  .tile .summary { margin: 8px 0 0; font-size: 17px; line-height: 1.47; max-width: 38ch; }
  .tile .learned { margin: 4px 0 0; font-size: 14px; line-height: 1.43; color: var(--dim); max-width: 42ch; }
  .tile .learned span { color: var(--ink); font-weight: 600; }
  .tile .links { margin-top: auto; padding-top: 14px; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 24px; font-size: 17px; }
  .tile .shot { margin-top: 20px; border-radius: 12px; }

  .writing { padding-block: clamp(56px, 8vw, 96px); text-align: center; display: grid; gap: 0; }
  .writing h2 { margin: 0 0 28px; font-family: var(--display); font-size: clamp(36px, 5.5vw, 56px); font-weight: 700; line-height: 1.07; }
  .post { display: grid; gap: 4px; padding: 18px 0; border-top: 1px solid var(--line); color: var(--ink); }
  .post:hover { text-decoration: none; }
  .post:hover .t { color: var(--link); }
  .post .t { font-size: 21px; font-weight: 600; }
  .post .d { font-size: 14px; color: var(--dim); }
  .writing .all { margin-top: 20px; }

  @media (max-width: 834px) {
    .tiles { grid-template-columns: 1fr; }
  }
</style>
