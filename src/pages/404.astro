---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <h1 class="title">Page not found</h1>
  <p class="msg">This page doesn't exist. <a class="more" href="/">Back to all work</a></p>
</Base>

<style>
  .title { font-stretch: 78%; font-weight: 750; font-size: clamp(38px, 5.6vw, 68px); line-height: .95; margin: 40px 0 20px; }
  .msg { border-top: 2px solid var(--ink); padding-top: 12px; font-size: 19px; margin: 0; }
</style>
