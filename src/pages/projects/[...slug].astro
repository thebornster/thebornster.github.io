---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const withPages = (await getCollection('projects'))
    .filter((p) => p.body?.trim())
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return withPages.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: withPages[(i + 1) % withPages.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Base title={d.title} description={d.summary} section="work">
  <a class="back" href="/">&larr; All work</a>
  <h1 class="display title">{d.title}</h1>

  <div class="meta g num">
    <div><span class="label">Year</span><span>{d.date.getUTCFullYear()}</span>{d.award && <span class="award">{d.award}</span>}</div>
    {d.event && <div><span class="label">Event</span><span>{d.event}</span></div>}
    {d.role && <div><span class="label">Role</span><span>{d.role}</span></div>}
    {d.stack.length > 0 && <div><span class="label">Stack</span><span>{d.stack.join(', ')}</span></div>}
    {Object.keys(d.links).length > 0 && (
      <div><span class="label">Links</span><span class="links">{Object.entries(d.links).map(([label, href]) => <a href={href}>{label}</a>)}</span></div>
    )}
  </div>

  {d.image && <Image class="hero-img" src={d.image} alt={d.imageAlt ?? ''} widths={[960, 1400, 2000]} sizes="100vw" />}

  <div class="g">
    <aside class="side num">
      {d.team && <><span class="label">Team</span><span>{d.team}</span></>}
      {d.outcome && <><span class="label">Outcome</span><span>{d.outcome}</span></>}
    </aside>
    <div class="prose"><Content /></div>
  </div>

  {next && next.id !== project.id && (
    <a class="next g" href={`/projects/${next.id}/`}>
      <span class="label">Next project</span>
      <span class="display">{next.data.title} &rarr;</span>
    </a>
  )}
</Base>

<style>
  .title { font-size: clamp(56px, 11vw, 136px); margin: 28px 0 18px; }
  .meta { border-top: 2px solid var(--ink); padding-top: 12px; margin-bottom: 28px; row-gap: 18px; }
  .meta > div { grid-column: span 3; display: grid; gap: 4px; font-size: 14px; align-content: start; }
  .meta .award { margin-top: 2px; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .hero-img { width: 100%; margin-bottom: 48px; }
  .side .label:not(:first-child) { margin-top: 12px; }
  .next { margin-top: 64px; border-top: 2px solid var(--ink); padding-top: 12px; text-decoration: none; align-items: baseline; row-gap: 8px; }
  .next .label { grid-column: span 3; }
  .next .display { grid-column: 4 / span 9; font-size: clamp(36px, 6vw, 72px); }
  .next:hover .display { color: var(--cobalt); }
  @media (max-width: 780px) {
    .meta > div { grid-column: span 6; }
    .next .label, .next .display { grid-column: 1 / -1; }
  }
</style>
