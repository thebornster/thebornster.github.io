---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../site';

export async function getStaticPaths() {
  const withPages = (await getCollection('projects'))
    .filter((p) => p.body?.trim())
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return withPages.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: withPages[(i + 1) % withPages.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const typeLabel = { software: 'Software', hardware: 'Hardware', hackathon: 'Hackathon' };
const facts = [
  ['Event', d.event],
  ['Role', d.role],
  ['Team', d.team],
  ['Stack', d.stack.join(', ')],
].filter(([, v]) => v);
---

<Base title={d.title} description={d.summary} section="work">
  <header class="article-head narrow">
    <a class="back" href="/#projects">&lsaquo; All projects</a>
    {d.award ? <p class="eyebrow award">{d.award}</p> : <p class="eyebrow">{typeLabel[d.type]}</p>}
    <h1>{d.title}</h1>
    <p class="dek">{d.summary}</p>
    {Object.keys(d.links).length > 0 && (
      <div class="links">{Object.entries(d.links).map(([label, href]) => <a class="chev" href={href}>{label}</a>)}</div>
    )}
  </header>

  <div class="band facts">
    <dl class="wrap">
      <div><dt>Date</dt><dd>{formatDate(d.date)}</dd></div>
      {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </div>

  <article class="prose narrow">
    {d.image && <Image src={d.image} alt={d.imageAlt ?? ''} widths={[720, 1080, 1440]} sizes="(max-width: 780px) 100vw, 700px" />}
    <Content />
    {d.learned && (
      <aside class="learned">
        <p class="eyebrow">What I learned</p>
        <p>{d.learned}</p>
      </aside>
    )}
  </article>

  {next && next.id !== project.id && (
    <div class="narrow">
      <a class="next" href={`/projects/${next.id}/`}>
        <span class="eyebrow">Next project</span>
        <span class="t chev">{next.data.title}</span>
      </a>
    </div>
  )}
</Base>

<style>
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 24px; margin-top: 10px; }
  .facts { padding-block: 28px; }
  .facts dl { margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 20px 48px; text-align: center; }
  .facts dt { font-size: 12px; font-weight: 600; color: var(--dim); text-transform: uppercase; letter-spacing: .04em; }
  .facts dd { margin: 4px 0 0; font-size: 15px; max-width: 30ch; }
  .learned { margin-top: 40px; background: var(--bg-alt); border-radius: 18px; padding: 24px 28px; }
  .learned p:last-child { margin: 6px 0 0; font-size: 19px; }
  .next { display: grid; gap: 6px; justify-items: center; text-align: center; margin-block: 32px 72px; padding: 36px 24px; border-radius: 18px; background: var(--bg-alt); color: var(--ink); }
  .next:hover { text-decoration: none; }
  .next .t { font-family: var(--display); font-size: clamp(26px, 3.4vw, 34px); font-weight: 700; color: var(--link); }
</style>
