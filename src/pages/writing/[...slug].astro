---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, readingTime } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} section="writing">
  <a class="back" href="/writing/">&larr; All writing</a>

  <div class="head g">
    <div class="side num">
      <span>{formatDate(post.data.date, { day: 'numeric', month: 'short', year: 'numeric' })}</span>
      <span>{readingTime(post.body)} min read</span>
      {post.data.topic && <span>{post.data.topic}</span>}
    </div>
    <h1>{post.data.title}</h1>
    <p class="dek">{post.data.description}</p>
  </div>

  <div class="g">
    <aside class="side"></aside>
    <article class="prose"><Content /></article>
  </div>
</Base>

<style>
  .head { border-top: 2px solid var(--ink); padding-top: 12px; margin: 32px 0 40px; row-gap: 18px; }
  .head .side { padding-top: 6px; }
  h1 { grid-column: 4 / span 9; font-stretch: 78%; font-weight: 750; font-size: clamp(38px, 5.6vw, 68px); line-height: .95; margin: 0; text-wrap: balance; }
  .dek { grid-column: 4 / span 7; font-size: 20px; line-height: 1.4; margin: 0; color: var(--dim); }
  @media (max-width: 780px) {
    h1, .dek { grid-column: 1 / -1; }
  }
</style>
