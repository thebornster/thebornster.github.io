---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, readingTime } from '../../site';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Writing" section="writing">
  <header class="article-head narrow">
    <h1>Writing</h1>
    <p class="dek">Notes on things I've built and what I learned along the way.</p>
  </header>
  <div class="list narrow">
    {posts.map((post) => (
      <a href={`/writing/${post.id}/`}>
        <span class="d num">{formatDate(post.data.date)} &middot; {readingTime(post.body)} min read</span>
        <span class="t">{post.data.title}</span>
        <span class="desc">{post.data.description}</span>
      </a>
    ))}
  </div>
</Base>

<style>
  .list { padding-bottom: 80px; }
  .list a { display: grid; gap: 4px; padding: 22px 0; border-top: 1px solid var(--line); color: var(--ink); }
  .list a:hover { text-decoration: none; }
  .list a:hover .t { color: var(--link); }
  .d { font-size: 14px; color: var(--dim); }
  .t { font-size: 24px; font-weight: 600; line-height: 1.2; }
  .desc { font-size: 17px; color: var(--dim); }
</style>
