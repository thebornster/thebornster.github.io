---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  section?: 'work' | 'writing';
}

const { title, description = site.pitch, section } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,400&family=JetBrains+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    <div class="page">
      <header class="hdr g">
        <a class="who" href="/">{site.name}</a>
        <div class="role">{site.role}</div>
        <nav>
          <a href="/" aria-current={section === 'work' ? 'page' : undefined}>Work</a>
          <a href="/writing/" aria-current={section === 'writing' ? 'page' : undefined}>Writing</a>
          {site.resume && <a href={site.resume}>Resume</a>}
          <a href={site.github}>GitHub</a>
        </nav>
      </header>

      <slot />

      <footer class="foot g">
        <div class="a">{site.email}</div>
        <div class="b">
          <a href={site.github}>GitHub</a>
          {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
          {site.resume && <a href={site.resume}>Resume (PDF)</a>}
        </div>
        <div class="cc num">&copy; {new Date().getFullYear()}</div>
      </footer>
    </div>
  </body>
</html>
