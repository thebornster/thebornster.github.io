---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  section?: 'work' | 'writing';
}

const { title, description = site.pitch, section } = Astro.props;
const hasPosts = (await getCollection('posts', (p) => !p.data.draft)).length > 0;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="who" href="/">{site.name}</a>
        <nav>
          <a href="/#projects" aria-current={section === 'work' ? 'page' : undefined}>Projects</a>
          {hasPosts && <a href="/writing/" aria-current={section === 'writing' ? 'page' : undefined}>Writing</a>}
          {site.resume && <a href={site.resume}>Resume</a>}
          <a href={site.github}>GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <span>Copyright &copy; {new Date().getFullYear()} {site.name}. Built with Astro.</span>
        <span class="links">
          {site.email && <span>{site.email}</span>}
          <a href={site.github}>GitHub</a>
          {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
          {site.resume && <a href={site.resume}>Resume</a>}
        </span>
      </div>
    </footer>
  </body>
</html>
